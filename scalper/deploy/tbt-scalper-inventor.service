[Unit]
Description=TBT scalper AI inventor (the lab) -- isolated research
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/tbt/scalper
EnvironmentFile=/home/tbt/scalper/.env
ExecStart=/home/tbt/scalper/venv/bin/python invent_run.py
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
