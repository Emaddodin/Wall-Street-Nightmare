[Unit]
Description=STRATTON OAKMONT scalper AI inventor (the lab) -- isolated research
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/stratton-oakmont/scalper
EnvironmentFile=/home/stratton-oakmont/scalper/.env
ExecStart=/home/stratton-oakmont/scalper/venv/bin/python invent_run.py
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
