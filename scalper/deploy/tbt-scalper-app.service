[Unit]
Description=TBT scalper phone app (isolated research project)
After=network.target

[Service]
User=root
WorkingDirectory=/home/tbt/scalper
EnvironmentFile=/home/tbt/scalper/.env
ExecStart=/home/tbt/scalper/venv/bin/python -u /home/tbt/scalper/app/app.py
Restart=always
RestartSec=8

[Install]
WantedBy=multi-user.target
