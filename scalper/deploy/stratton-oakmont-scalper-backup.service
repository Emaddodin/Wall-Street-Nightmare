[Unit]
Description=STRATTON OAKMONT scalper daily backup (isolated research project)

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/stratton-oakmont/scalper
ExecStart=/bin/bash -c 'mkdir -p data/backups && tar czf data/backups/scalper-$(date +%%Y%%m%%d).tar.gz data/state data/logs data/research data/reports; find data/backups -name "*.tar.gz" -mtime +7 -delete'

[Install]
WantedBy=multi-user.target
