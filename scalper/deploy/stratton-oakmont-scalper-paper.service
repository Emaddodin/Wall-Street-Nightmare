[Unit]
Description=STRATTON OAKMONT scalper paper book (isolated research project)
After=network.target

[Service]
User=root
WorkingDirectory=/home/stratton-oakmont/scalper
EnvironmentFile=/home/stratton-oakmont/scalper/.env
ExecStart=/home/stratton-oakmont/scalper/venv/bin/python -u /home/stratton-oakmont/scalper/paper_trade.py --profile aggressive --poll 15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
