[Unit]
Description=STRATTON OAKMONT scalper phone app (isolated research project)
After=network.target

[Service]
User=root
WorkingDirectory=/home/stratton-oakmont/scalper
EnvironmentFile=/home/stratton-oakmont/scalper/.env
ExecStart=/home/stratton-oakmont/scalper/venv/bin/python -u /home/stratton-oakmont/scalper/app/app.py
Restart=always
RestartSec=8

[Install]
WantedBy=multi-user.target
