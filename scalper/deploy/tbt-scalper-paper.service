[Unit]
Description=TBT scalper paper book (isolated research project)
After=network.target

[Service]
User=root
WorkingDirectory=/home/tbt/scalper
EnvironmentFile=/home/tbt/scalper/.env
ExecStart=/home/tbt/scalper/venv/bin/python -u /home/tbt/scalper/paper_trade.py --profile aggressive --poll 15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
