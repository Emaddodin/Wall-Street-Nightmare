[Unit]
Description=Stratton Oakmont Gold Scalper Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ict_sniper
Environment=PANEL_RPID=82.115.21.155.nip.io
Environment=PANEL_PORT=8443
ExecStart=/root/ict_sniper/venv/bin/python -u panel.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stratton-panel

[Install]
WantedBy=multi-user.target
