# Serves the VPS Kronos forecasts as paste lines for the TradingView indicator (port 8791).
# Reads the Kronos chart service's forecast JSON (found by itself; Gold Desk's is the fallback) and
# never runs Kronos itself. Locked with the chart's key (/root/kronos/chart/token.txt).
# Installed by dashboard/vps/setup.sh when the Gold Desk icon updates the VPS.
[Unit]
Description=Kronos paste lines for TradingView
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /root/kronos/pine/pine_feed.py
Restart=always
RestartSec=5
Nice=10
MemoryMax=100M

[Install]
WantedBy=multi-user.target
