[Unit]
# Monitoring that does not depend on anyone being awake -- not the operator,
# not a laptop, not a chat session. It runs here, it decides here, and it
# shouts here.
Description=TBT health check -- shout if anything is wrong

[Service]
Type=oneshot
User=tbt
WorkingDirectory=/home/tbt/bot
ExecStart=/home/tbt/venv/bin/python /home/tbt/bot/tools/healthcheck.py --notify
