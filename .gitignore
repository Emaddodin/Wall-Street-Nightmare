# Secrets. The exchange keys and the ntfy topic live here and must never
# leave this machine.
.env
.env.*
*.pem
*.key

# Runtime state, not source. The book, the watchlist, the measurements and
# the case-study samples are all regenerated by the running system, and
# data/ alone is ~55 MB of append-only history.
data/
logs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Local backups and stale copies kept for reference on the box, not source.
*.bak
*.bak-*
*.presplit.bak
*.precouncil.bak
old/

# macOS
.DS_Store

# Runtime log at the repo root
*.log
