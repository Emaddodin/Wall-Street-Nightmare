[Unit]
Description=TBT coin finder -- the biggest candles in the market right now

[Service]
Type=oneshot
User=tbt
WorkingDirectory=/home/tbt/bot
# Replaces the old scanner's ranking, which asked what a coin had done over
# weeks. That is a statement about the coin's character, not about today, and
# it put the market's biggest movers outside the list entirely: NIULAIUSDT,
# measured at reach 78.8 and seventy-five minutes to target, was dropped for
# producing none of a shape that needs a quiet band -- on a day it moved 44%.
#
# Over 163 of the indicator's own signals on real candles, ATR was the single
# strongest thing separating winners from losers:
#
#   ATR under 2.5%     8.6% reached +10%    -54.6% per trade
#   ATR 2.5 - 4.0%    27.3%                 +57.6%
#   ATR over 5.5%     39.1%                +128.8%
ExecStart=/home/tbt/venv/bin/python -u /home/tbt/bot/atrscan.py \
  --top 60 --min-atr 2.5 --min-vol 1000000
