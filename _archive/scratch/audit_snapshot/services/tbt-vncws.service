[Unit]
# Bridges the loopback-only VNC server to a WebSocket the browser can speak,
# on loopback as well -- the panel is what reaches it, and the panel is what
# holds the login. Nothing here is exposed to the network directly.
Description=TBT VNC websocket bridge for the phone
After=tbt-vnc.service
Requires=tbt-vnc.service

[Service]
User=tbt
ExecStart=/usr/bin/websockify 127.0.0.1:6080 127.0.0.1:5900
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
