[Unit]
Description=TBT beast -- the same measured edges, maximum size, no budget
After=tbt-chrome.service
Wants=tbt-chrome.service

[Service]
User=tbt
WorkingDirectory=/home/tbt/bot
# The wild animal: the same engine, the same learned filter, the same
# target and stop -- and nothing held back.
#
# The target is still 5%, the stop still 1.25%, the entry still at the
# candle's edge, the trend still respected, the ATR and agent floors still
# the measured ones. What changes is everything about appetite:
#
#   --book data/beast.json   its own ledger, lock and journal, beside the
#                            book's. Two ledgers, one market, no collision.
#   --frac 1.0 with         the whole wallet on every trade, one position
#   --max-exposure 1.0       at a time, all of it.
#   --lev 75                the stop ceiling still rules: with a 1.25% stop
#                            the book refuses to be liquidated before its
#                            stop, so this means "the most the stop allows",
#                            about 57x, per coin.
#   --per-day 0             no budget. The pacing bar is switched off; every
#                            signal that passes the measured gates trades.
#   --filter-min 0.09       the learned model's floor sits lower than the
#                            book's 0.123 top-10% cut, so the beast eats more
#                            of the model's tail -- the part measured closer
#                            to the break-even line, which is the whole point
#                            of running it as a separate animal.
#   no loss limit            do or die. If the beast eats itself, that is
#                            data too, and the book is untouched.
#
# Same charts, same scout, same model file, read-only: the beast is a
# second pair of eyes on the same signals, not a second set of signals.
ExecStart=/home/tbt/venv/bin/python -u /home/tbt/bot/papertrade.py \
  --book /home/tbt/bot/data/beast.json \
  --source combo --scout --skip-window 1 --entry edge \
  --interval 2.0 --sprint 0.2 --stack \
  --tp 5 --lev 75 --frac 1.0 --sl 1.25 --max-exposure 1.0 \
  --sl-atr 0 --tp-atr 0 --tp-r 0 --tp-leg 0 --r-adapt 0 --risk-pct 0 \
  --min-confidence 0 --min-agents 3 --min-atr 2.5 --with-trend \
  --per-coin-lev \
  --min-entry 40 --min-lev 0 \
  --per-day 0 --day-start 17.5 --max-per-day 0 --fill-bars 8 \
  --step-at 10000 --step-frac 0.25 --break-even 0 --ct-exit 3.5 \
  --filter-model /home/tbt/bot/data/dataset/samples/model.npz --filter-min 0.09
Restart=always
RestartSec=8
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
