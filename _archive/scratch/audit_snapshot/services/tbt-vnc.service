[Unit]
Description=VNC into the chart display, loopback only
After=tbt-xvfb.service
Requires=tbt-xvfb.service

[Service]
User=tbt
Environment=DISPLAY=:99
# -localhost is the whole security model here: the only way in is an SSH
# tunnel. An open VNC port would hand anyone the logged-in TradingView
# session and, through it, the account.
ExecStart=/usr/bin/x11vnc -display :99 -localhost -forever -shared -rfbauth /home/tbt/.vnc/passwd -quiet
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
