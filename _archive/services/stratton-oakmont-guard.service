[Unit]
Description=STRATTON OAKMONT watchdog: keeps the stack alive and the box locked down
After=stratton-oakmont-paper.service

[Service]
# runs as root because repairs mean systemctl restarts and firewall checks
User=root
WorkingDirectory=/home/stratton-oakmont/bot
ExecStart=/home/stratton-oakmont/venv/bin/python -u /home/stratton-oakmont/bot/guard.py --interval 120 --resolution 15 --scout-window 1 --charts PONSUSDT USELESSUSDT
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
