[Unit]
# Records every signal the real indicator prints, and the path that followed.
# The Python port of the strategy is not faithful, so this file is the only
# honest dataset there is. It reads the charts once a minute and never writes
# to them.
Description=STRATTON OAKMONT signal recorder
After=stratton-oakmont-chrome.service
Wants=stratton-oakmont-chrome.service

[Service]
User=stratton
WorkingDirectory=/home/stratton-oakmont/bot
ExecStart=/home/stratton-oakmont/venv/bin/python -u /home/stratton-oakmont/bot/recorder.py
Restart=always
RestartSec=20
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
