[Unit]
Description=TBT watchdog: keeps the stack alive and the box locked down
After=tbt-paper.service

[Service]
# runs as root because repairs mean systemctl restarts and firewall checks
User=root
WorkingDirectory=/home/tbt/bot
ExecStart=/home/tbt/venv/bin/python -u /home/tbt/bot/guard.py --interval 120 --resolution 15 --scout-window 1 --charts PONSUSDT USELESSUSDT
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
