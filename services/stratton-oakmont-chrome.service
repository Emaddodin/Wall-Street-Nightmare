[Unit]
Description=Chrome holding the TradingView charts
After=stratton-oakmont-xvfb.service stratton-oakmont-wm.service
Requires=stratton-oakmont-xvfb.service

[Service]
User=stratton
Environment=DISPLAY=:99
# --ozone-platform=x11 --autoplay-policy=user-gesture-required --disable-smooth-scrolling --disable-gpu-compositing --disable-features=Translate,MediaRouter,BackForwardCache is not optional on a bare Xvfb: recent Chrome picks its
# window backend automatically, and without a Wayland session it can come up
# with no mapped window at all -- the process runs, CDP answers, and the
# desktop stays empty, which is exactly what VNC showed.
# The debug port stays on loopback; this browser is logged into the account.
ExecStart=/usr/bin/google-chrome --ozone-platform=x11 --autoplay-policy=user-gesture-required --disable-smooth-scrolling --disable-gpu-compositing --disable-features=Translate,MediaRouter,BackForwardCache --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 --user-data-dir=/home/stratton-oakmont/chrome-profile --no-first-run --no-default-browser-check --disable-features=Translate --disable-background-timer-throttling --disable-renderer-backgrounding --window-position=0,0 --window-size=1280,760 https://www.tradingview.com/chart/
Restart=always
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
