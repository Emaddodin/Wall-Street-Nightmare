[Unit]
Description=Report the book every morning at 08:00 Tehran

[Timer]
# The unit is UTC; Tehran is +03:30, so 08:00 local is 04:30 UTC. Written as
# a timezone-aware expression instead, so it stays 8am when the offset moves.
OnCalendar=*-*-* 08:00:00 Asia/Tehran
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
