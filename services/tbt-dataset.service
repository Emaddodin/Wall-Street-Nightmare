[Unit]
# Rebuilds data/dataset/ from the recorded signals and outcomes, so the
# flow dataset grows with the recorder instead of going stale. Reads files
# only -- it touches no chart and no service.
Description=TBT flow dataset builder

[Service]
User=tbt
WorkingDirectory=/home/tbt/bot
# The last stage retrains the LIVE filter, not merely evaluates it: the
# books hot-reload model.npz every minute, and a model that is never
# retrained goes quietly stale -- which the healthcheck would then only
# be able to shout about after two days. The save is atomic (tmp+rename),
# so a hot reload can never read a half-written artifact.
ExecStart=/bin/sh -c '/home/tbt/venv/bin/python -u /home/tbt/bot/dataset/make_dataset.py && /home/tbt/venv/bin/python -u /home/tbt/bot/dataset/sweep.py > /home/tbt/bot/data/dataset/sweep.txt && /home/tbt/venv/bin/python -u /home/tbt/bot/dataset/sampler.py > /home/tbt/bot/data/dataset/samples/build.txt && /home/tbt/venv/bin/python -u /home/tbt/bot/dataset/selector.py --samples /home/tbt/bot/data/dataset/samples/features.npz > /home/tbt/bot/data/dataset/selector.txt && /home/tbt/venv/bin/python -u /home/tbt/bot/dataset/selector.py --save-model /home/tbt/bot/data/dataset/samples/model.npz > /home/tbt/bot/data/dataset/retrain.txt'
Restart=no
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
