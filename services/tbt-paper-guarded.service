[Unit]
Description=TBT guarded paper -- the 50% rule plus the measured trail
After=tbt-chrome.service
Wants=tbt-chrome.service

[Service]
User=tbt
WorkingDirectory=/home/tbt/bot
# The parallel test the operator asked for: the SAME 50% rule as the
# paper book, plus the one protection the data supports.
#
# Measured over the 10,702 recorded paths (dataset/pullback.py):
#   baseline (target/stop only)     expectancy -0.92% of margin
#   break-even at +1%               -1.00%   (chokes winners)
#   break-even at +1 x ATR          -0.68%
#   trail 0.75 x ATR behind best    +0.12%   <- the only positive one
#   pullback exit at 60% target     -1.26%   (saves stops, kills winners)
#
# And the pain being answered: 589 of the recorded stops (5.5%) had
# been past 70% of the target before the market reversed -- the trail
# locks the profit in front of exactly that reversal, never below
# entry. The same thing the operator described: it went to the target's
# doorstep and pulled back.
#
# Everything else is the operator's 50% rule, unchanged. Paper only;
# --live cannot appear here and does not. Its ledger is its own:
# data/paper-guarded.json, with its journal beside it.
ExecStart=/home/tbt/venv/bin/python -u /home/tbt/bot/papertrade.py \
  --book /home/tbt/bot/data/paper-guarded.json \
  --source combo --scout --skip-window 1 --entry edge \
  --interval 2.0 --sprint 0.2 --stack \
  --tp 5 --lev 40 --frac 0.5 --sl 1.25 --max-exposure 0.5 \
  --sl-atr 1.0 --tp-margin 0.50 --trail-atr 0.75 \
  --tp-atr 0 --tp-r 0 --tp-leg 0 --r-adapt 0 --risk-pct 0 \
  --min-confidence 0 --min-agents 3 --min-atr 2.5 --with-trend \
  --per-coin-lev \
  --min-entry 40 --min-lev 0 \
  --per-day 0 --day-start 17.5 --max-per-day 0 --fill-bars 8 \
  --step-at 10000 --step-frac 0.25 --break-even 0 --ct-exit 3.5 \
  --filter-model /home/tbt/bot/data/dataset/samples/model.npz --filter-min 0.485
Restart=always
RestartSec=8
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
